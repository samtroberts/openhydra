OpenHydra: tokenizer-only subcommands of llama-server, for a verifier that counts the tokens of text
a provider delivered without the model's weights (agent/src/token_count.rs).
  --export-vocab <model.gguf> <out.gguf>  the model's metadata (tokenizer included), no tensors
  --count-tokens <vocab.gguf>             the token count of the text on stdin

--- a/tools/server/main.cpp
+++ b/tools/server/main.cpp
@@ -1,5 +1,156 @@
+#include "common.h"
+#include "gguf.h"
+#include "llama.h"
+
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <iostream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#include <fcntl.h>
+#include <io.h>
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <shellapi.h>
+#endif
+
 int llama_server(int argc, char ** argv);
 
+// OpenHydra: two tokenizer-only subcommands, handled before the server parses its arguments. A
+// verifier uses them to count the tokens of text a provider delivered, without the model's weights.
+//   --export-vocab <model.gguf> <out.gguf>  write the model's metadata (its tokenizer among it) and no
+//                                            tensors: a few MB, all that --count-tokens needs
+//   --count-tokens <vocab.gguf>             print how many tokens the text on stdin is, as the model
+//                                            generates it: no BOS, special tokens as themselves
+
+static void quiet(ggml_log_level, const char *, void *) {}
+
+static int export_vocab(const char * in, const char * out) {
+    // Paths are UTF-8 (the arguments are, on Windows too), as gguf and llama.cpp open them.
+    const std::filesystem::path in_path = std::filesystem::u8path(in);
+    const std::filesystem::path out_path = std::filesystem::u8path(out);
+    // Written beside `out` and moved there only once it loads: a failed export leaves nothing behind.
+    const std::string tmp = std::string(out) + ".tmp";
+    const std::filesystem::path tmp_path = std::filesystem::u8path(tmp);
+    // Writing over the model it reads, either way, would destroy it.
+    std::error_code ec;
+    for (const std::filesystem::path & p : { out_path, tmp_path }) {
+        if (std::filesystem::exists(p, ec) && std::filesystem::equivalent(in_path, p, ec)) {
+            fprintf(stderr, "export-vocab: %s is the model itself; write the vocabulary elsewhere\n", out);
+            return 1;
+        }
+    }
+    gguf_init_params params = { /*no_alloc =*/ true, /*ctx =*/ nullptr };
+    gguf_context * src = gguf_init_from_file(in, params);
+    if (!src) {
+        fprintf(stderr, "export-vocab: can't read %s\n", in);
+        return 1;
+    }
+    gguf_context * dst = gguf_init_empty();
+    gguf_set_kv(dst, src);
+    // A split model's keys would send the loader looking for the other parts of a file that has none.
+    for (const char * key : { "split.no", "split.count", "split.tensors.count" }) {
+        gguf_remove_key(dst, key);
+    }
+    const bool ok = gguf_write_to_file(dst, tmp.c_str(), /*only_meta =*/ true);
+    gguf_free(dst);
+    gguf_free(src);
+    if (!ok) {
+        std::filesystem::remove(tmp_path, ec);
+        fprintf(stderr, "export-vocab: can't write %s\n", out);
+        return 1;
+    }
+    // Only a vocabulary that loads is of any use: check it as --count-tokens will load it.
+    llama_log_set(quiet, nullptr);
+    llama_backend_init();
+    llama_model_params mparams = llama_model_default_params();
+    mparams.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(tmp.c_str(), mparams);
+    const bool loads = model != nullptr;
+    if (model) {
+        llama_model_free(model);
+    }
+    llama_backend_free();
+    if (!loads) {
+        std::filesystem::remove(tmp_path, ec);
+        fprintf(stderr, "export-vocab: %s doesn't load as a vocabulary\n", out);
+        return 1;
+    }
+    // Replaces an existing `out` in one step, on Windows too.
+    std::filesystem::rename(tmp_path, out_path, ec);
+    if (ec) {
+        std::filesystem::remove(tmp_path, ec);
+        fprintf(stderr, "export-vocab: can't write %s\n", out);
+        return 1;
+    }
+    return 0;
+}
+
+static int count_tokens(const char * path) {
+#ifdef _WIN32
+    _setmode(_fileno(stdin), _O_BINARY);
+#endif
+    llama_log_set(quiet, nullptr);
+    llama_backend_init();
+    llama_model_params mparams = llama_model_default_params();
+    mparams.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(path, mparams);
+    if (!model) {
+        fprintf(stderr, "count-tokens: can't load a vocabulary from %s\n", path);
+        return 1;
+    }
+    const std::string text((std::istreambuf_iterator<char>(std::cin)), std::istreambuf_iterator<char>());
+    const std::vector<llama_token> tokens =
+        common_tokenize(llama_model_get_vocab(model), text, /*add_special =*/ false, /*parse_special =*/ true);
+    printf("%zu\n", tokens.size());
+    llama_model_free(model);
+    llama_backend_free();
+    return 0;
+}
+
 int main(int argc, char ** argv) {
+#ifdef _WIN32
+    // The ANSI argv mangles non-ASCII paths; llama.cpp reads paths as UTF-8 (common_params_parse
+    // rebuilds argv the same way, but these subcommands run before it).
+    std::vector<std::string> utf8_args;
+    std::vector<char *> utf8_argv;
+    int wargc = 0;
+    if (wchar_t ** wargv = CommandLineToArgvW(GetCommandLineW(), &wargc)) {
+        for (int i = 0; i < wargc; i++) {
+            const int n = WideCharToMultiByte(CP_UTF8, 0, wargv[i], -1, nullptr, 0, nullptr, nullptr);
+            std::string arg(n > 0 ? n - 1 : 0, '\0');
+            if (n > 1) {
+                WideCharToMultiByte(CP_UTF8, 0, wargv[i], -1, arg.data(), n, nullptr, nullptr);
+            }
+            utf8_args.push_back(std::move(arg));
+        }
+        LocalFree(wargv);
+        for (auto & a : utf8_args) {
+            utf8_argv.push_back(a.data());
+        }
+        utf8_argv.push_back(nullptr);
+        if (wargc == argc && argc >= 2 && (strcmp(argv[1], "--export-vocab") == 0 || strcmp(argv[1], "--count-tokens") == 0)) {
+            argv = utf8_argv.data();
+        }
+    }
+#endif
+    if (argc >= 2 && strcmp(argv[1], "--export-vocab") == 0) {
+        if (argc != 4) {
+            fprintf(stderr, "usage: %s --export-vocab <model.gguf> <out.gguf>\n", argv[0]);
+            return 2;
+        }
+        return export_vocab(argv[2], argv[3]);
+    }
+    if (argc >= 2 && strcmp(argv[1], "--count-tokens") == 0) {
+        if (argc != 3) {
+            fprintf(stderr, "usage: %s --count-tokens <vocab.gguf> < text\n", argv[0]);
+            return 2;
+        }
+        return count_tokens(argv[2]);
+    }
     return llama_server(argc, argv);
 }
