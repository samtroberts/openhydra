@@ -521,6 +521,22 @@ impl GemmaRmsNorm {
         })
     }
 
+    /// As [`new`](Self::new), but when `already_shifted` the checkpoint's weight already holds `1 + w`
+    /// (MLX-converted checkpoints: mlx_lm's `sanitize` bakes the `+1` in), so it is used as is;
+    /// `original_weight` keeps the zero-centred form.
+    pub fn new_shifted(size: usize, eps: f64, vb: ShardedVarBuilder, already_shifted: bool) -> Result<Self> {
+        if !already_shifted {
+            return Self::new(size, eps, vb);
+        }
+        let weight = vb.get(size, "weight")?;
+        let original_weight = (&weight - 1.0)?;
+        Ok(Self {
+            eps,
+            original_weight,
+            weight,
+        })
+    }
+
     pub fn weight(&self) -> &Tensor {
         &self.weight
     }
