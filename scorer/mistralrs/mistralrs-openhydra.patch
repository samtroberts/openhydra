diff --git a/mistralrs/examples/advanced/prompt_scoring/main.rs b/mistralrs/examples/advanced/prompt_scoring/main.rs
new file mode 100644
index 0000000..e8bc550
--- /dev/null
+++ b/mistralrs/examples/advanced/prompt_scoring/main.rs
@@ -0,0 +1,46 @@
+//! Teacher-forced prompt scoring through the library API (`Model::score_prompt`).
+//!
+//! Scores every token-id list in a JSON file (`[[id, ...], ...]`) and writes per-token
+//! log-probabilities and top-1 ids as `[{"lp": [...], "top1": [...]}, ...]`.
+//!
+//! Run with: `cargo run --release --example prompt_scoring -p mistralrs -- --model-id <dir> --ids ids.json --out out.json`
+
+use std::time::Instant;
+
+use anyhow::Result;
+use clap::Parser;
+use mistralrs::ModelBuilder;
+
+#[derive(Parser)]
+struct Args {
+    /// Model to load (Hugging Face id or local directory).
+    #[arg(short, long)]
+    model_id: String,
+    /// JSON file with a list of token-id lists to score.
+    #[arg(long)]
+    ids: String,
+    /// Where to write the scores.
+    #[arg(long)]
+    out: String,
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    let args = Args::parse();
+    let model = ModelBuilder::new(&args.model_id).with_logging().build().await?;
+    let texts: Vec<Vec<u32>> = serde_json::from_str(&std::fs::read_to_string(&args.ids)?)?;
+    let mut out = Vec::new();
+    for (i, ids) in texts.into_iter().enumerate() {
+        let start = Instant::now();
+        let scores = model.score_prompt(ids).await?;
+        println!(
+            "text {i}: {} tokens scored in {:.0} ms, mean logprob {:.4}",
+            scores.token_ids.len(),
+            start.elapsed().as_secs_f64() * 1e3,
+            scores.logprobs.iter().sum::<f32>() / scores.logprobs.len() as f32
+        );
+        out.push(serde_json::json!({"lp": scores.logprobs, "top1": scores.top1_ids}));
+    }
+    std::fs::write(&args.out, serde_json::to_string(&out)?)?;
+    Ok(())
+}
