diff --git a/mistralrs-core/src/prompt_scoring.rs b/mistralrs-core/src/prompt_scoring.rs
new file mode 100644
index 0000000..b34ac58
--- /dev/null
+++ b/mistralrs-core/src/prompt_scoring.rs
@@ -0,0 +1,96 @@
+//! Teacher-forced prompt scoring.
+//!
+//! A verifier that knows which model a server claims to run can check that claim by asking the
+//! server how likely each token of a fixed reference text is, given the tokens before it, and
+//! comparing the answers with a trusted reference engine. This module turns the raw prompt logits
+//! returned for a `return_raw_logits` request (every prompt row, see `inputs_processor`) into those
+//! per-token log-probabilities, plus each token's rank and the model's own top choice.
+
+use candle_core::{DType, Result, Tensor, D};
+use serde::Serialize;
+
+/// Teacher-forced scores for one prompt. Position `t` scores `token_ids[t + 1]` given
+/// `token_ids[..=t]`, so every vector has `token_ids.len() - 1` entries.
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct PromptScores {
+    pub token_ids: Vec<u32>,
+    /// `log P(token_ids[t + 1] | token_ids[..=t])`, computed in f32.
+    pub logprobs: Vec<f32>,
+    /// 1 + the number of vocabulary entries the model rated strictly more likely than the actual token.
+    pub ranks: Vec<u32>,
+    /// The model's most likely next token at each position.
+    pub top1_ids: Vec<u32>,
+    /// The log-probability of `top1_ids[t]`.
+    pub top1_logprobs: Vec<f32>,
+}
+
+/// Scores `token_ids` from the raw prompt logits of a `return_raw_logits` request: one tensor per
+/// prompt chunk, each `(rows, vocab)` (a single row may arrive as `(vocab,)`), in prompt order.
+pub fn prompt_scores_from_logits(logits_chunks: &[Tensor], token_ids: &[u32]) -> Result<PromptScores> {
+    let rows = logits_chunks
+        .iter()
+        .map(|chunk| match chunk.rank() {
+            1 => chunk.unsqueeze(0),
+            2 => Ok(chunk.clone()),
+            3 => chunk.flatten_to(1),
+            r => candle_core::bail!("prompt scoring: unexpected logits rank {r}"),
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let logits = Tensor::cat(&rows, 0)?.to_dtype(DType::F32)?;
+    let n = logits.dim(0)?;
+    if n != token_ids.len() {
+        candle_core::bail!(
+            "prompt scoring: got logits for {n} positions but {} prompt tokens (were all prompt rows returned?)",
+            token_ids.len()
+        );
+    }
+    if n < 2 {
+        candle_core::bail!("prompt scoring needs at least 2 tokens, got {n}");
+    }
+    let logp = candle_nn::ops::log_softmax(&logits, D::Minus1)?.narrow(0, 0, n - 1)?;
+    let next = Tensor::from_vec(token_ids[1..].to_vec(), (n - 1, 1), logp.device())?;
+    let actual = logp.gather(&next, 1)?;
+    let ranks = logp
+        .broadcast_gt(&actual)?
+        .to_dtype(DType::U32)?
+        .sum(D::Minus1)?
+        .to_vec1::<u32>()?
+        .into_iter()
+        .map(|higher| higher + 1)
+        .collect();
+    Ok(PromptScores {
+        token_ids: token_ids.to_vec(),
+        logprobs: actual.squeeze(1)?.to_vec1::<f32>()?,
+        ranks,
+        top1_ids: logp.argmax(D::Minus1)?.to_vec1::<u32>()?,
+        top1_logprobs: logp.max(D::Minus1)?.to_vec1::<f32>()?,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use candle_core::Device;
+
+    #[test]
+    fn scores_match_a_hand_computed_log_softmax() -> Result<()> {
+        // 3 prompt tokens over a 4-token vocabulary, split across two chunks.
+        let chunk_a = Tensor::new(&[[2.0f32, 1.0, 0.0, -1.0], [0.0, 0.0, 3.0, 0.0]], &Device::Cpu)?;
+        let chunk_b = Tensor::new(&[1.0f32, 1.0, 1.0, 1.0], &Device::Cpu)?;
+        let scores = prompt_scores_from_logits(&[chunk_a, chunk_b], &[0, 1, 3])?;
+        let lse0 = (2f32.exp() + 1f32.exp() + 1.0 + (-1f32).exp()).ln();
+        let lse1 = (3.0f32 + 3f32.exp()).ln();
+        assert!((scores.logprobs[0] - (1.0 - lse0)).abs() < 1e-6);
+        assert!((scores.logprobs[1] - (0.0 - lse1)).abs() < 1e-6);
+        assert_eq!(scores.ranks, vec![2, 2]);
+        assert_eq!(scores.top1_ids, vec![0, 2]);
+        assert!((scores.top1_logprobs[1] - (3.0 - lse1)).abs() < 1e-6);
+        Ok(())
+    }
+
+    #[test]
+    fn rejects_logits_that_do_not_cover_the_prompt() {
+        let last_row_only = Tensor::zeros((1, 4), DType::F32, &Device::Cpu).unwrap();
+        assert!(prompt_scores_from_logits(&[last_row_only], &[0, 1, 2]).is_err());
+    }
+}
