diff --git a/mistralrs-server-core/src/prompt_logprobs.rs b/mistralrs-server-core/src/prompt_logprobs.rs
new file mode 100644
index 0000000..9776154
--- /dev/null
+++ b/mistralrs-server-core/src/prompt_logprobs.rs
@@ -0,0 +1,198 @@
+//! `POST /v1/prompt_logprobs`: teacher-forced prompt scoring.
+//!
+//! Scores exact prompt token ids in one prefill (no generation) and returns, for every position,
+//! the log-probability of the actual next token, its rank and the model's top choice. The
+//! `prompt_logprobs` array follows vLLM's shape (`null` for the first token, then a map from token
+//! id to `{logprob, rank}`), so a verifier can read either engine the same way.
+
+use anyhow::Error as AnyhowError;
+use axum::{
+    extract::{rejection::JsonRejection, Json, State},
+    response::IntoResponse,
+};
+use mistralrs_core::{
+    prompt_scores_from_logits, Constraint, NormalRequest, PromptScores, Request, RequestMessage,
+    Response, SamplingParams,
+};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+use crate::{
+    handler_core::{
+        create_response_channel, openai_error_from_error, send_request_with_model, ApiError,
+        ApiErrorKind,
+    },
+    types::ExtractedMistralRsState,
+    util::validate_model_name,
+};
+
+#[derive(Debug, Clone, Deserialize, Serialize, utoipa::ToSchema)]
+pub struct PromptLogprobsRequest {
+    #[serde(default = "default_model")]
+    pub model: String,
+    /// The exact token ids to score (include BOS if the model expects one).
+    pub prompt_token_ids: Vec<u32>,
+}
+
+fn default_model() -> String {
+    "default".to_string()
+}
+
+#[derive(Debug, Serialize, utoipa::ToSchema)]
+pub struct PromptLogprobsResponse {
+    pub model: String,
+    #[schema(value_type = Object)]
+    pub scores: Value,
+    /// vLLM-style: `[null, {"<id>": {"logprob": f, "rank": r}, ...}, ...]`.
+    #[schema(value_type = Vec<Object>)]
+    pub prompt_logprobs: Vec<Value>,
+}
+
+pub enum PromptLogprobsResponder {
+    Json(PromptLogprobsResponse),
+    InternalError(AnyhowError),
+    ValidationError(AnyhowError),
+}
+
+impl IntoResponse for PromptLogprobsResponder {
+    fn into_response(self) -> axum::response::Response {
+        match self {
+            Self::Json(r) => Json(r).into_response(),
+            Self::InternalError(e) => openai_error_from_error(e.as_ref(), ApiErrorKind::Internal),
+            Self::ValidationError(e) => {
+                openai_error_from_error(e.as_ref(), ApiErrorKind::InvalidRequest)
+            }
+        }
+    }
+}
+
+fn vllm_prompt_logprobs(scores: &PromptScores) -> Vec<Value> {
+    let mut out = vec![Value::Null];
+    for t in 0..scores.logprobs.len() {
+        let mut entry = serde_json::Map::new();
+        entry.insert(
+            scores.token_ids[t + 1].to_string(),
+            json!({"logprob": scores.logprobs[t], "rank": scores.ranks[t]}),
+        );
+        entry
+            .entry(scores.top1_ids[t].to_string())
+            .or_insert(json!({"logprob": scores.top1_logprobs[t], "rank": 1}));
+        out.push(Value::Object(entry));
+    }
+    out
+}
+
+#[utoipa::path(
+    post,
+    tag = "Mistral.rs",
+    path = "/v1/prompt_logprobs",
+    request_body = PromptLogprobsRequest,
+    responses((status = 200, description = "Teacher-forced prompt scores", body = PromptLogprobsResponse))
+)]
+pub async fn prompt_logprobs(
+    State(state): ExtractedMistralRsState,
+    payload: Result<Json<PromptLogprobsRequest>, JsonRejection>,
+) -> PromptLogprobsResponder {
+    let req = match payload {
+        Ok(Json(r)) => r,
+        Err(e) => {
+            return PromptLogprobsResponder::ValidationError(AnyhowError::new(
+                ApiError::from_json_rejection(e),
+            ))
+        }
+    };
+    if let Err(e) = validate_model_name(&req.model, state.clone()) {
+        return PromptLogprobsResponder::ValidationError(e.into());
+    }
+    if req.prompt_token_ids.len() < 2 {
+        return PromptLogprobsResponder::ValidationError(AnyhowError::new(ApiError::new(
+            ApiErrorKind::InvalidRequest,
+            "prompt_token_ids must contain at least 2 tokens.",
+            Some("invalid_input"),
+            Some("prompt_token_ids"),
+        )));
+    }
+    let model_id = (req.model != "default").then(|| req.model.clone());
+    let (tx, mut rx) = create_response_channel(Some(1));
+    let request = Request::Normal(Box::new(NormalRequest {
+        id: state.next_request_id(),
+        queued_at: None,
+        messages: RequestMessage::CompletionTokens(req.prompt_token_ids.clone()),
+        sampling_params: SamplingParams {
+            // One step: a raw-logits request finishes after the prompt forward (0 is rejected).
+            max_len: Some(1),
+            ..SamplingParams::deterministic()
+        },
+        seed: None,
+        response: tx,
+        return_logprobs: false,
+        is_streaming: false,
+        suffix: None,
+        constraint: Constraint::None,
+        tool_choice: None,
+        tools: None,
+        logits_processors: None,
+        // Raw-logits requests get every prompt row, run alone in their prompt batch and skip the prefix cache.
+        return_raw_logits: true,
+        web_search_options: None,
+        enable_code_execution: false,
+        enable_shell: false,
+        shell_options: None,
+        code_execution_permission: None,
+        code_execution_approval_notifier: None,
+        agent_permission: None,
+        agent_approval_handler: None,
+        agent_approval_notifier: None,
+        max_tool_rounds: None,
+        tool_dispatch_url: None,
+        model_id: model_id.clone(),
+        adapter: None,
+        truncate_sequence: false,
+        session_id: None,
+        files: None,
+        input_files: Vec::new(),
+    }));
+    if let Err(e) = send_request_with_model(&state, request, model_id.as_deref()).await {
+        return PromptLogprobsResponder::InternalError(e.into());
+    }
+    let scores = loop {
+        match rx.recv().await {
+            Some(Response::Raw {
+                logits_chunks,
+                tokens,
+            }) => {
+                if tokens != req.prompt_token_ids {
+                    return PromptLogprobsResponder::InternalError(anyhow::anyhow!(
+                        "engine scored {} tokens, expected the {} requested",
+                        tokens.len(),
+                        req.prompt_token_ids.len()
+                    ));
+                }
+                match prompt_scores_from_logits(&logits_chunks, &req.prompt_token_ids) {
+                    Ok(s) => break s,
+                    Err(e) => return PromptLogprobsResponder::InternalError(e.into()),
+                }
+            }
+            Some(Response::ValidationError(e)) => {
+                return PromptLogprobsResponder::ValidationError(anyhow::anyhow!("{e}"))
+            }
+            Some(other) => match other.as_result() {
+                Err(e) => {
+                    tracing::warn!("prompt_logprobs failed: {e}");
+                    return PromptLogprobsResponder::InternalError(anyhow::anyhow!("{e}"));
+                }
+                Ok(_) => continue,
+            },
+            None => {
+                return PromptLogprobsResponder::InternalError(anyhow::anyhow!(
+                    "engine closed the response channel"
+                ))
+            }
+        }
+    };
+    PromptLogprobsResponder::Json(PromptLogprobsResponse {
+        model: req.model,
+        prompt_logprobs: vllm_prompt_logprobs(&scores),
+        scores: serde_json::to_value(&scores).unwrap_or(Value::Null),
+    })
+}
