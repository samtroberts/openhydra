+    // ========================================================================
+    // Prompt scoring
+    // ========================================================================
+
+    /// Teacher-forced prompt scoring: how likely the model finds each token of `token_ids` given
+    /// the tokens before it, plus each token's rank and the model's top choice, from one prefill
+    /// with no generation. Pass exact token ids (include BOS if the model expects one).
+    ///
+    /// The request runs as a raw-logits request, so it gets its own prompt batch and bypasses the
+    /// prefix cache even while other requests are being served.
+    pub async fn score_prompt(&self, token_ids: Vec<u32>) -> crate::error::Result<PromptScores> {
+        self.score_prompt_with_model(token_ids, None).await
+    }
+
+    /// [`score_prompt`](Self::score_prompt) against a specific model. If `model_id` is `None`, the
+    /// request is sent to the default model.
+    pub async fn score_prompt_with_model(
+        &self,
+        token_ids: Vec<u32>,
+        model_id: Option<&str>,
+    ) -> crate::error::Result<PromptScores> {
+        if token_ids.len() < 2 {
+            return Err(SdkError::RequestValidation(
+                "score_prompt needs at least 2 tokens".to_string(),
+            ));
+        }
+        let (tx, mut rx) = channel(1);
+        let request = Request::Normal(Box::new(NormalRequest {
+            messages: RequestMessage::CompletionTokens(token_ids.clone()),
+            sampling_params: SamplingParams {
+                // One step: a raw-logits request finishes after the prompt forward (0 is rejected).
+                max_len: Some(1),
+                ..SamplingParams::deterministic()
+            },
+            seed: None,
+            response: tx,
+            return_logprobs: false,
+            is_streaming: false,
+            id: 0,
+            queued_at: None,
+            constraint: Constraint::None,
+            suffix: None,
+            tools: None,
+            tool_choice: None,
+            logits_processors: None,
+            return_raw_logits: true,
+            web_search_options: None,
+            enable_code_execution: false,
+            enable_shell: false,
+            shell_options: None,
+            code_execution_permission: None,
+            code_execution_approval_notifier: None,
+            agent_permission: None,
+            agent_approval_handler: None,
+            agent_approval_notifier: None,
+            max_tool_rounds: None,
+            tool_dispatch_url: None,
+            model_id: model_id.map(|s| s.to_string()),
+            adapter: None,
+            truncate_sequence: false,
+            session_id: None,
+            files: None,
+            input_files: Vec::new(),
+        }));
+        self.runner.get_sender(model_id)?.send(request).await?;
+        loop {
+            let resp = rx
+                .recv()
+                .await
+                .ok_or(SdkError::Channel("channel closed unexpectedly".into()))?
+                .as_result()?;
+            match resp {
+                ResponseOk::Raw {
+                    logits_chunks,
+                    tokens,
+                } => {
+                    if tokens != token_ids {
+                        return Err(SdkError::Inference(
+                            format!(
+                                "engine scored {} tokens, expected the {} requested",
+                                tokens.len(),
+                                token_ids.len()
+                            )
+                            .into(),
+                        ));
+                    }
+                    return prompt_scores_from_logits(&logits_chunks, &token_ids)
+                        .map_err(|e| SdkError::Inference(Box::new(e)));
+                }
+                ResponseOk::AgenticToolCallProgress { .. }
+                | ResponseOk::BlockDenoisingProgress(_)
+                | ResponseOk::File(_) => continue,
+                _ => return Err(SdkError::UnexpectedResponse { expected: "Raw" }),
+            }
+        }
+    }
+
     // ========================================================================
     // Convenience Methods
     // ========================================================================
