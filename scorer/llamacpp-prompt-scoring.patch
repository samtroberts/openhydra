+// Teacher-forced prompt scoring on a separate, short-lived llama_context over the serving weights,
+// in decodes of `chunk` tokens. With `out` null only the forward passes run (the startup probe).
+// False when the context can't be created or a decode fails (typically out of device memory).
+bool server_routes::score_prompt_tokens(const llama_tokens & ids, int chunk, json * out) {
+    const int n = (int) ids.size();
+    chunk = std::min(n, chunk);
+    // logits for every position of a chunk: keep chunks small so the output buffer
+    // (chunk * n_vocab floats) stays modest for large vocabularies
+    llama_context_params cparams = common_context_params_to_llama(params);
+    cparams.n_ctx     = n;
+    cparams.n_batch   = chunk;
+    cparams.n_ubatch  = chunk;
+    cparams.n_seq_max = 1;
+    cparams.n_outputs_max         = chunk; // logits for every position (the server default is 1 per sequence)
+    cparams.n_outputs_max_per_seq = chunk;
+    cparams.embeddings = false;
+    llama_context * lctx = llama_init_from_model(ctx_server.model_tgt, cparams);
+    if (lctx == nullptr) {
+        return false;
+    }
+    std::unique_ptr<llama_context, decltype(&llama_free)> guard(lctx, llama_free);
+    const int n_vocab = llama_vocab_n_tokens(ctx_server.vocab);
+
+    json lps = json::array(), ranks = json::array(), top_ids = json::array(), top_lps = json::array();
+    llama_batch batch = llama_batch_init(chunk, 0, 1);
+    for (int start = 0; start < n; start += chunk) {
+        const int len = std::min(chunk, n - start);
+        common_batch_clear(batch);
+        for (int i = 0; i < len; i++) {
+            const int pos = start + i;
+            common_batch_add(batch, ids[pos], pos, { 0 }, pos + 1 < n); // no logits needed for the last token
+        }
+        if (llama_decode(lctx, batch) != 0) {
+            llama_batch_free(batch);
+            return false;
+        }
+        if (out == nullptr) {
+            continue;
+        }
+        // The per-position log-softmax over the whole vocabulary dominates the cost (the forward
+        // pass is far cheaper), so positions are spread over the CPU cores. Each position is
+        // computed exactly as before, so the results are unchanged.
+        const int n_out = std::max(0, std::min(len, n - 1 - start));
+        std::vector<const float *> rows(n_out);
+        for (int i = 0; i < n_out; i++) {
+            rows[i] = llama_get_logits_ith(lctx, i);
+        }
+        std::vector<double> c_lp(n_out), c_top(n_out);
+        std::vector<int> c_rank(n_out), c_arg(n_out);
+        auto score_rows = [&](int first, int step) {
+            for (int i = first; i < n_out; i += step) {
+                const float * lg = rows[i];
+                const llama_token next = ids[start + i + 1];
+                double mx = lg[0];
+                int arg = 0;
+                for (int v = 1; v < n_vocab; v++) {
+                    if (lg[v] > mx) { mx = lg[v]; arg = v; }
+                }
+                double z = 0.0;
+                int rank = 1;
+                for (int v = 0; v < n_vocab; v++) {
+                    z += std::exp((double) lg[v] - mx);
+                    rank += lg[v] > lg[next];
+                }
+                const double lse = mx + std::log(z);
+                c_lp[i] = (double) lg[next] - lse;
+                c_top[i] = mx - lse;
+                c_rank[i] = rank;
+                c_arg[i] = arg;
+            }
+        };
+        const int n_thr = std::max(1, std::min<int>(n_out, (int) std::thread::hardware_concurrency()));
+        std::vector<std::thread> workers;
+        for (int w = 1; w < n_thr; w++) {
+            workers.emplace_back(score_rows, w, n_thr);
+        }
+        score_rows(0, n_thr);
+        for (auto & t : workers) {
+            t.join();
+        }
+        for (int i = 0; i < n_out; i++) {
+            lps.push_back(c_lp[i]);
+            ranks.push_back(c_rank[i]);
+            top_ids.push_back(c_arg[i]);
+            top_lps.push_back(c_top[i]);
+        }
+    }
+    llama_batch_free(batch);
+    if (out != nullptr) {
+        *out = json{
+            {"token_ids", ids},
+            {"logprobs", lps},
+            {"ranks", ranks},
+            {"top1_ids", top_ids},
+            {"top1_logprobs", top_lps},
+        };
+    }
+    return true;
+}
+
+void server_routes::probe_prompt_scoring() {
+    if (!params.endpoint_prompt_logprobs) {
+        return;
+    }
+    // A scoring context comes on top of the serving context, and --fit doesn't count it. Score the
+    // longest accepted prompt once now, so a server that can't do it says so at startup instead of
+    // failing challenges later; a smaller chunk needs less memory.
+    const int n_vocab = llama_vocab_n_tokens(ctx_server.vocab);
+    llama_tokens ids(PROMPT_SCORING_MAX_TOKENS);
+    for (int i = 0; i < PROMPT_SCORING_MAX_TOKENS; i++) {
+        ids[i] = (llama_token) ((1000 + 7919LL * i) % n_vocab);
+    }
+    std::lock_guard<std::mutex> lock(mutex_prompt_scoring);
+    for (int chunk = std::max(params.prompt_scoring_chunk, PROMPT_SCORING_MIN_CHUNK); chunk >= PROMPT_SCORING_MIN_CHUNK; chunk /= 2) {
+        if (score_prompt_tokens(ids, chunk, nullptr)) {
+            prompt_scoring_chunk.store(chunk);
+            if (chunk < params.prompt_scoring_chunk) {
+                SRV_WRN("prompt scoring: chunks of %d tokens did not fit in device memory, using %d\n", params.prompt_scoring_chunk, chunk);
+            }
+            SRV_INF("prompt scoring: ready (up to %d tokens, chunks of %d)\n", PROMPT_SCORING_MAX_TOKENS, chunk);
+            return;
+        }
+        SRV_WRN("prompt scoring: a %d-token prompt in chunks of %d did not fit in device memory\n", PROMPT_SCORING_MAX_TOKENS, chunk);
+    }
+    prompt_scoring_chunk.store(0);
+    SRV_ERR("%s", "prompt scoring DISABLED: it does not fit in device memory next to the model. Offload fewer layers "
+                  "(-ngl), raise --fit-target, or on Apple Silicon try --load-mode none (a memory-mapped model is "
+                  "mapped whole into GPU memory)\n");
+}
