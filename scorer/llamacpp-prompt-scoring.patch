+    // Teacher-forced prompt scoring: for a token sequence, the log-prob of each token given the
+    // tokens before it (plus its rank and the top-1 alternative). Runs outside the slot scheduler on a
+    // separate, short-lived llama_context over the same weights, one request at a time, so a score
+    // never depends on what else the server is batching. Base weights only: LoRA adapters and control
+    // vectors applied to the serving context are not applied here.
+    //
+    //   POST /v1/prompt_logprobs {"prompt_token_ids": [t0, t1, ...]}
+    //   -> {"model": ..., "scores": {"token_ids": [...], "logprobs": [...], "ranks": [...],
+    //                                "top1_ids": [...], "top1_logprobs": [...]}}
+    //
+    // The arrays after token_ids have one entry per token after the first.
+    this->post_prompt_logprobs = [this](const server_http_req & req) {
+        auto res = create_response();
+        if (!params.endpoint_prompt_logprobs) {
+            res->error(format_error_response("This server does not support prompt scoring. Start it with `--prompt-scoring`", ERROR_TYPE_NOT_SUPPORTED));
+            return res;
+        }
+        if (prompt_scoring_chunk.load() == 0) {
+            res->error(format_error_response("prompt scoring is disabled: it did not fit in device memory at startup", ERROR_TYPE_NOT_SUPPORTED));
+            return res;
+        }
+        const json body = json::parse(req.body);
+        const llama_tokens ids = body.at("prompt_token_ids").get<llama_tokens>();
+        if (ids.size() < 2 || ids.size() > (size_t) PROMPT_SCORING_MAX_TOKENS) {
+            res->error(format_error_response(string_format("prompt_token_ids must hold 2 to %d tokens", PROMPT_SCORING_MAX_TOKENS), ERROR_TYPE_INVALID_REQUEST));
+            return res;
+        }
+        const int n_vocab = llama_vocab_n_tokens(ctx_server.vocab);
+        for (const llama_token id : ids) {
+            if (id < 0 || id >= n_vocab) {
+                res->error(format_error_response("prompt_token_ids contains an invalid token id", ERROR_TYPE_INVALID_REQUEST));
+                return res;
+            }
+        }
+
+        std::lock_guard<std::mutex> lock(mutex_prompt_scoring);
+
+        // A decode that runs out of device memory (e.g. other work on the GPU since startup) is
+        // retried on a fresh context with half the chunk, and the smaller chunk is kept.
+        json scores;
+        int chunk = prompt_scoring_chunk.load();
+        while (!score_prompt_tokens(ids, chunk, &scores)) {
+            if (chunk <= PROMPT_SCORING_MIN_CHUNK) {
+                res->error(format_error_response("prompt scoring failed: not enough device memory", ERROR_TYPE_UNAVAILABLE));
+                return res;
+            }
+            chunk /= 2;
+            prompt_scoring_chunk.store(chunk);
+            SRV_WRN("prompt scoring: decode failed, retrying with chunks of %d tokens\n", chunk);
+        }
+        res->ok(json{
+            {"model", meta->model_name},
+            {"scores", scores},
+        });
+        return res;
+    };
+
+    // GET on the scoring route answers 405, so a client can tell "scoring available" (405) from
+    // "no such route" (404) without sending a prompt
+    this->get_prompt_logprobs = [this](const server_http_req &) {
+        auto res = create_response(true);
+        if (prompt_scoring_chunk.load() == 0) {
+            res->error(format_error_response("prompt scoring is disabled: it did not fit in device memory at startup", ERROR_TYPE_NOT_SUPPORTED));
+            return res;
+        }
+        res->error(json{{"code", 405}, {"message", "use POST"}, {"type", "invalid_request_error"}});
+        return res;
+    };
