{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the commands and core APIs the UI uses. App commands the UI never calls (connector_preview, uninstall_cli, web_search) are not granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:resources:allow-close",
    "updater:default",
    "process:allow-restart",
    "allow-get-state",
    "allow-identity-info",
    "allow-reveal-path",
    "allow-confirm-sharing",
    "allow-open-external",
    "allow-start-provider",
    "allow-restart-provider",
    "allow-start-gateway",
    "allow-stop-provider",
    "allow-stop-gateway",
    "allow-save-share-policy",
    "allow-read-share-policy",
    "allow-export-card",
    "allow-preview-card",
    "allow-import-card",
    "allow-list-cards",
    "allow-remove-imported-card",
    "allow-take-pending-card",
    "allow-list-swarms",
    "allow-create-swarm",
    "allow-swarm-enroll-request",
    "allow-preview-enroll-request",
    "allow-swarm-approve-member",
    "allow-swarm-remote-scope",
    "allow-swarm-revoke-member",
    "allow-preview-swarm-credential",
    "allow-swarm-accept-credential",
    "allow-forget-swarm",
    "allow-reset-share-policy",
    "allow-detect-engines-now",
    "allow-system-info",
    "allow-install-plan",
    "allow-install-engine",
    "allow-installed-engines",
    "allow-run-engine",
    "allow-gateway-health",
    "allow-chat-completion",
    "allow-chat-completion-stream",
    "allow-chat-stop",
    "allow-status-snapshot",
    "allow-save-settings",
    "allow-load-sessions",
    "allow-save-sessions",
    "allow-load-stats",
    "allow-save-stats",
    "allow-device-hostname",
    "allow-app-version",
    "allow-appimage-status",
    "allow-integrate-appimage",
    "allow-export-logs",
    "allow-connector-status",
    "allow-connector-apply",
    "allow-connector-disconnect",
    "allow-open-gui",
    "allow-connector-test",
    "allow-cli-status",
    "allow-install-cli"
  ]
}
