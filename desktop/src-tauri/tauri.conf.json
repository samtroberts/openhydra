{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHydra",
  "version": "0.3.24",
  "identifier": "co.openhydra.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run sidecar && npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenHydra",
        "width": 1000,
        "height": 720,
        "minWidth": 900,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost data: ws://localhost:1420 http://localhost:1420; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share your machine's inference engines and use the OpenHydra network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/openhydra-agent", "binaries/openhydra-scorer"],
    "resources": { "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt" },
    "fileAssociations": [
      {
        "ext": ["openhydra"],
        "name": "OpenHydra Card",
        "description": "A signed OpenHydra model card",
        "mimeType": "application/x-openhydra+json",
        "role": "Viewer",
        "rank": "Owner",
        "contentTypes": ["co.openhydra.card"],
        "exportedType": {
          "identifier": "co.openhydra.card",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "linux": {
      "deb": {
        "postInstallScript": "scripts/linux-postinstall.sh",
        "preRemoveScript": "scripts/linux-preremove.sh"
      },
      "rpm": {
        "postInstallScript": "scripts/linux-postinstall.sh",
        "preRemoveScript": "scripts/linux-preremove.sh"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "scripts/windows-installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://dl.openhydra.co/updater/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RUI4NjgxMjQ1QTg5N0IKUldSN2lWb2tnWWJyS1ZpNUE1dGIxZnRHSDAvQkIzRUhrOXVOY3JrTVN1eitmRldaUWR6SDRkVUQK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["openhydra"]
      }
    }
  }
}
