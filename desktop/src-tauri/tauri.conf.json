{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHydra",
  "version": "0.1.0",
  "identifier": "co.openhydra.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenHydra",
        "width": 1000,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share your machine's inference engines and use the OpenHydra network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/openhydra-agent"]
  }
}
