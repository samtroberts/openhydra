# /etc/openhydra/msmtprc — how probe-run.sh sends its emails (msmtp, through Google Workspace).
# The password is an app password (Google Account › Security › App passwords), kept in
# /etc/openhydra/smtp-password, readable only by root and the openhydra-monitor group.
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
# Give up after 20 s rather than hang the probe run (some hosts block outbound mail ports).
timeout        20

account        google
host           smtp.gmail.com
port           587
from           sam@openhydra.co
user           sam@openhydra.co
passwordeval   cat /etc/openhydra/smtp-password

account default : google
